<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FCB1010Studio</AssemblyName>
    <RootNamespace>FCB1010.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Version>0.1.0</Version>
    <AssemblyTitle>FCB1010 Studio</AssemblyTitle>
    <Product>FCB1010 Studio</Product>
    <Company>FCB1010 Studio</Company>
    <Description>Free open-source Behringer FCB1010 editor with regular UnO support.</Description>
  </PropertyGroup>

  <!-- Self-contained single-file exe for `dotnet publish -r win-x64` / package.ps1 / CI. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FCB1010.Core\FCB1010.Core.csproj" />
    <ProjectReference Include="..\FCB1010.Midi\FCB1010.Midi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
    <AvaloniaResource Include="Assets/app-icon-256.png" />
    <AvaloniaResource Include="Assets/fcb1010-device.png" />
    <AvaloniaResource Include="Assets/ref/exp-pedal-ref.png" />
    <AvaloniaResource Include="Assets/ref/footswitch-ref.png" />
    <AvaloniaResource Include="Assets/ref/footswitch-blank.png" />
    <AvaloniaResource Include="Assets/ref/display-panel-ref.png" />
    <AvaloniaResource Include="Assets/ref/fcb1010-full-ref.png" />
    <AvaloniaResource Include="Assets/ref/fcb1010-brand.png" />
  </ItemGroup>
</Project>
