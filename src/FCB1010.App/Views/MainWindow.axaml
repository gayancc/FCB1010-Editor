<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FCB1010.App.ViewModels"
        xmlns:ctrl="using:FCB1010.App.Controls"
        xmlns:svc="using:FCB1010.App.Services"
        xmlns:midi="using:FCB1010.Midi"
        x:Class="FCB1010.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="FCB1010 Studio"
        Icon="/Assets/app.ico"
        Width="1600" Height="780"
        MinWidth="1200" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">

  <Window.Resources>
    <DataTemplate x:Key="MapPedalPad" x:DataType="vm:MapCellViewModel">
      <Button Classes="mapPad"
              Classes.selected="{Binding Selected}"
              Classes.live="{Binding HasMessages}"
              Classes.stomp="{Binding IsStomp}"
              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectMapCellCommand}"
              CommandParameter="{Binding Index}"
              ToolTip.Tip="{Binding Name}">
        <Grid RowDefinitions="Auto,*" RowSpacing="1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource StageSignal}"
                       Text="{Binding SwitchNumber}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource StageTeal}" IsVisible="{Binding HasMessages}"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource StageAmber}" IsVisible="{Binding IsStomp}"/>
              <Ellipse Width="7" Height="7" Fill="#55606A" IsVisible="{Binding HasExpression}"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" FontFamily="{DynamicResource FontDisplay}" FontSize="14" FontWeight="SemiBold"
                     Foreground="#C2CAD2" Text="{Binding ShortName}" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- Compact routing tile matching studio reference proportions (~168×72) -->
    <DataTemplate x:Key="MixStripTemplate" x:DataType="vm:ChannelRouteViewModel">
      <Border Classes="mixStrip" Width="156" Height="68">
        <Grid ColumnDefinitions="4,*">
          <Border Background="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                  CornerRadius="6,0,0,6"/>
          <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="11,9,11,9">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                         Foreground="#7A848E" Text="{Binding KindTitle}" LetterSpacing="1.1"/>
              <TextBlock FontFamily="{DynamicResource FontDisplay}" FontSize="18" FontWeight="Bold"
                         Foreground="#F0F4F7" Text="{Binding Label}"/>
              <Border Height="2" Width="26" HorizontalAlignment="Left" CornerRadius="1" Margin="0,3,0,0"
                      Background="{Binding AccentHex, Converter={StaticResource HexBrush}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1"
                        Margin="8,0,0,0">
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                         Foreground="#7A848E" Text="CH" HorizontalAlignment="Center" LetterSpacing="1"/>
              <ctrl:ScrubValueField Width="38" Height="26" Minimum="1" Maximum="16"
                                    DigitsFontSize="17"
                                    Value="{Binding Channel, Mode=TwoWay}" FormatString="00"
                                    HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- ═══ COMMAND DECK — link-aware operations bay ═══ -->
    <Border DockPanel.Dock="Top" BorderBrush="#1A1E22" BorderThickness="0,0,0,1" Padding="10,6">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Color="#080A0C" Offset="0"/>
          <GradientStop Color="#0C0E12" Offset="0.5"/>
          <GradientStop Color="#080A0C" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">

        <!-- Identity + link pulse -->
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="appTitle" Text="FCB1010 Studio" VerticalAlignment="Center"/>
          <Border Classes="linkBadge" Classes.online="{Binding Connected}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#3DBA72" IsVisible="{Binding Connected}"/>
              <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="#E8A03A" IsVisible="{Binding !Connected}"/>
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                         Text="{Binding ConnectionLabel}" VerticalAlignment="Center"
                         Foreground="#E6EAED"/>
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#5C656E"
                         Text="{Binding FirmwareLabel}" VerticalAlignment="Center" MaxWidth="140"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding FirmwareLabel}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Workspace rail -->
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#101418" CornerRadius="6" Padding="3">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <Button Classes="seg" Content="DEVICE" Classes.active="{Binding IsTwinWorkspace}"
                    Command="{Binding SelectWorkspaceCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Twin}"/>
            <Button Classes="seg" Content="MAP" Classes.active="{Binding IsMapWorkspace}"
                    Command="{Binding SelectWorkspaceCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Map}"/>
            <Button Classes="seg" Content="ROUTING" Classes.active="{Binding IsRoutingWorkspace}"
                    Command="{Binding SelectWorkspaceCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Routing}"/>
            <Button Classes="seg" Content="DIAG" Classes.active="{Binding IsDiagnosticsWorkspace}"
                    Command="{Binding SelectWorkspaceCommand}" CommandParameter="{x:Static vm:WorkspaceKind.Diagnostics}"/>
          </StackPanel>
        </Border>

        <!-- Operations: ports → link → device I/O → archive -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">

          <!-- Port bay — locked while linked -->
          <Border Classes="opBay" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="bayLabel" Text="IN" VerticalAlignment="Center"/>
                <ComboBox Classes="compact port" Width="140" IsEnabled="{Binding CanChangePorts}"
                          ItemsSource="{Binding InputPorts}" SelectedItem="{Binding SelectedInput}"
                          ToolTip.Tip="{Binding SelectedInput.Name}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="midi:MidiPortInfo">
                      <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="bayLabel" Text="OUT" VerticalAlignment="Center"/>
                <ComboBox Classes="compact port" Width="140" IsEnabled="{Binding CanChangePorts}"
                          ItemsSource="{Binding OutputPorts}" SelectedItem="{Binding SelectedOutput}"
                          ToolTip.Tip="{Binding SelectedOutput.Name}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="midi:MidiPortInfo">
                      <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <ComboBox Classes="compact port" Width="88" IsEnabled="{Binding CanChangePorts}"
                        ItemsSource="{Binding FirmwareChoices}" SelectedItem="{Binding SelectedFirmware}"
                        ToolTip.Tip="Firmware family for SysEx"/>
            </StackPanel>
          </Border>

          <!-- Link control — LINK / UNLINK -->
          <Button Classes="linkBtn" Classes.online="{Binding Connected}"
                  Content="{Binding LinkButtonLabel}"
                  Command="{Binding ToggleLinkCommand}"
                  ToolTip.Tip="Establish or close the MIDI link"/>

          <Border Width="1" Background="#252A2F" Margin="8,4"/>

          <!-- Device I/O — gated by MIDI link (commands also CanExecute=false when offline) -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="deck" Content="READ" Command="{Binding ReadDeviceCommand}"
                    ToolTip.Tip="Pull configuration dump from the FCB1010"/>
            <Button Classes="deck primary" Content="WRITE" Command="{Binding WriteDeviceCommand}"
                    ToolTip.Tip="Push editor dump to the FCB1010"/>
            <Button Classes="deck" Content="LIVE" Classes.active="{Binding IsLiveMode}"
                    Command="{Binding ToggleLiveCommand}"
                    ToolTip.Tip="Preview MIDI while pressing pedals"/>
          </StackPanel>

          <Border Width="1" Background="#252A2F" Margin="8,4"/>

          <!-- Archive — always available -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="deck" Content="OPEN" Command="{Binding OpenCommand}" ToolTip.Tip="Open project or SysEx"/>
            <Button Classes="deck" Content="SAVE" Command="{Binding SaveCommand}" ToolTip.Tip="Save project"/>
            <Button Classes="deck icon" Content="↶" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
            <Button Classes="deck icon" Content="↷" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ WORKSPACES ═══ -->
    <Panel>

      <!-- DEVICE: photo IS the UI — docked flush, no void between device and editor -->
      <DockPanel IsVisible="{Binding IsTwinWorkspace}">

        <!-- ═══ 2. ASSEMBLED FCB1010 HARDWARE CONTROLS ═══ -->
        <Border DockPanel.Dock="Top" Background="#0A0A0A" Padding="6,2">
          <ctrl:Fcb1010Surface HorizontalAlignment="Stretch" MinHeight="260" MaxHeight="360"
                               ViewModel="{Binding}"/>
        </Border>

        <!-- ═══ STAGE RACK — fixed faceplate, no scroll / no clip ═══ -->
        <Border BorderBrush="#14181C" BorderThickness="0,1,0,0" ClipToBounds="False"
                MinHeight="280" Padding="14,12,14,8">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#050607" Offset="0"/>
              <GradientStop Color="#0A0C0F" Offset="0.55"/>
              <GradientStop Color="#07090B" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>

          <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

            <!-- Main rack: identity + lanes -->
            <Grid ColumnDefinitions="168,*" ColumnSpacing="14">

              <!-- Compact stage mark -->
              <Border Background="#080A0C" BorderBrush="#1A1F26" BorderThickness="1"
                      CornerRadius="10" Padding="12,10" VerticalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Classes="stageEyebrow" Text="STAGE MARK"/>
                  <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                    <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource StageSignal}"
                               Text="{Binding Bank, StringFormat={}{0:00}}"/>
                    <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="22" FontWeight="Bold"
                               Foreground="#2A3038" Text="·" VerticalAlignment="Center"/>
                    <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource StageAmber}"
                               Text="{Binding Footswitch, StringFormat={}{0:00}}"/>
                  </StackPanel>
                  <TextBlock Classes="stageEyebrow" Text="BANK · PRESET" Margin="0,0,0,4" Opacity="0.65"/>
                  <TextBox Classes="stageName" Text="{Binding BankName}" PlaceholderText="Bank name…"
                           ToolTip.Tip="Editor-only bank name; stored in project/local metadata, not on the pedal" FontSize="11" Margin="0,0,0,6"/>
                  <Border Background="#12161B" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource StageTeal}" Text="{Binding RoleLabel}" LetterSpacing="1"/>
                  </Border>
                  <TextBox Classes="stageName" Text="{Binding PresetName}" PlaceholderText="Preset name…"
                           ToolTip.Tip="Editor-only preset name; stored in project/local metadata, not on the pedal" FontSize="13"/>
                  <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9" Foreground="#5C656E"
                             Text="{Binding FlowText}" TextWrapping="Wrap" Margin="0,8,0,0" MaxLines="3"/>
                </StackPanel>
              </Border>

              <!-- Transmit rack -->
              <StackPanel Grid.Column="1" Spacing="10">

                <!-- PROGRAM lane — wraps, never scrolls -->
                <Grid ColumnDefinitions="76,*">
                  <TextBlock Classes="laneLabel" Text="PROGRAM" VerticalAlignment="Top" Margin="0,8,0,0"/>
                  <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                    <ItemsControl ItemsSource="{Binding ProgramActionsActive}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MidiActionItemViewModel">
                          <Border Classes="midiModule">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <CheckBox Classes="compact" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="Bold"
                                         Foreground="{DynamicResource StageTeal}" Text="{Binding SlotLabel}"
                                         VerticalAlignment="Center"/>
                              <TextBlock Classes="midi" Text="{Binding ChannelLabel}" VerticalAlignment="Center"/>
                              <ctrl:ScrubValueField Width="44" Minimum="0" Maximum="127"
                                                    Value="{Binding Primary, Mode=TwoWay}" FormatString="000"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ProgramActionsIdle}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MidiActionItemViewModel">
                          <Button Classes="ghostAdd" Height="32" Content="{Binding SlotLabel, StringFormat=+ {0}}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EnableMidiSlotCommand}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </WrapPanel>
                </Grid>

                <!-- CONTROL lane -->
                <Grid ColumnDefinitions="76,*">
                  <TextBlock Classes="laneLabel" Text="CONTROL" VerticalAlignment="Top" Margin="0,8,0,0"/>
                  <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6">
                    <ItemsControl ItemsSource="{Binding ControlActionsActive}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MidiActionItemViewModel">
                          <Border Classes="midiModule">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <CheckBox Classes="compact" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="Bold"
                                         Foreground="{DynamicResource StageAmber}" Text="{Binding SlotLabel}"
                                         VerticalAlignment="Center"/>
                              <ctrl:ScrubValueField Width="40" Minimum="0" Maximum="127"
                                                    Value="{Binding Primary, Mode=TwoWay}" FormatString="000" ToolTip.Tip="CC# · drag ↕ · dbl-click"/>
                              <ctrl:ScrubValueField Width="40" Minimum="0" Maximum="127"
                                                    Value="{Binding Secondary, Mode=TwoWay}" FormatString="000" ToolTip.Tip="Value · drag ↕ · dbl-click"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ControlActionsIdle}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="4"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MidiActionItemViewModel">
                          <Button Classes="ghostAdd" Height="32" Content="{Binding SlotLabel, StringFormat=+ {0}}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EnableMidiSlotCommand}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding NoteActions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" ItemSpacing="4"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MidiActionItemViewModel">
                          <Panel>
                            <Border Classes="midiModule" IsVisible="{Binding Enabled}">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <CheckBox Classes="compact" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9" FontWeight="Bold"
                                           Foreground="#E8D5A3" Text="NOTE" VerticalAlignment="Center"/>
                                <ctrl:ScrubValueField Width="44" Minimum="0" Maximum="127"
                                                      Value="{Binding Primary, Mode=TwoWay}" FormatString="000"/>
                              </StackPanel>
                            </Border>
                            <Button Classes="ghostAdd" Height="32" Content="+ NOTE" IsVisible="{Binding !Enabled}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).EnableMidiSlotCommand}"
                                    CommandParameter="{Binding}"/>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </WrapPanel>
                </Grid>

                <!-- Expression + contact — fixed height bay, nothing clipped -->
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10" MinHeight="108">
                  <Border Classes="expDeck" ClipToBounds="False" MinHeight="100" Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <ctrl:ExpValueDial Width="64" Height="64"
                                         Value="{Binding ExpressionAValue}"
                                         Minimum="{Binding ExpressionAMin}"
                                         Maximum="{Binding ExpressionAMax}"
                                         Accent="#FF9F1C" Caption="LIVE"
                                         VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <CheckBox Classes="compact" IsChecked="{Binding ExpressionAEnabled}" VerticalAlignment="Center"/>
                          <TextBlock Classes="laneLabel" Text="EXP A" Foreground="{DynamicResource StageAmber}"/>
                          <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#5C656E"
                                     Text="CC" VerticalAlignment="Center"/>
                          <ctrl:ScrubValueField Width="40" Minimum="0" Maximum="127"
                                                Value="{Binding ExpressionAController, Mode=TwoWay}" FormatString="000"
                                                IsEnabled="{Binding ExpressionAEnabled}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="stageEyebrow" Text="MIN" VerticalAlignment="Center"/>
                            <ctrl:ScrubValueField Classes="compact" Width="36" Minimum="0" Maximum="127"
                                                  Value="{Binding ExpressionAMin, Mode=TwoWay}" FormatString="000"
                                                  IsEnabled="{Binding ExpressionAEnabled}"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="stageEyebrow" Text="MAX" VerticalAlignment="Center"/>
                            <ctrl:ScrubValueField Classes="compact" Width="36" Minimum="0" Maximum="127"
                                                  Value="{Binding ExpressionAMax, Mode=TwoWay}" FormatString="000"
                                                  IsEnabled="{Binding ExpressionAEnabled}"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Classes="expDeck" Grid.Column="1" ClipToBounds="False" MinHeight="100" Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <ctrl:ExpValueDial Width="64" Height="64"
                                         Value="{Binding ExpressionBValue}"
                                         Minimum="{Binding ExpressionBMin}"
                                         Maximum="{Binding ExpressionBMax}"
                                         Accent="#2EC4B6" Caption="LIVE"
                                         VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <CheckBox Classes="compact" IsChecked="{Binding ExpressionBEnabled}" VerticalAlignment="Center"/>
                          <TextBlock Classes="laneLabel" Text="EXP B" Foreground="{DynamicResource StageTeal}"/>
                          <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#5C656E"
                                     Text="CC" VerticalAlignment="Center"/>
                          <ctrl:ScrubValueField Width="40" Minimum="0" Maximum="127"
                                                Value="{Binding ExpressionBController, Mode=TwoWay}" FormatString="000"
                                                IsEnabled="{Binding ExpressionBEnabled}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="stageEyebrow" Text="MIN" VerticalAlignment="Center"/>
                            <ctrl:ScrubValueField Classes="compact" Width="36" Minimum="0" Maximum="127"
                                                  Value="{Binding ExpressionBMin, Mode=TwoWay}" FormatString="000"
                                                  IsEnabled="{Binding ExpressionBEnabled}"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="stageEyebrow" Text="MAX" VerticalAlignment="Center"/>
                            <ctrl:ScrubValueField Classes="compact" Width="36" Minimum="0" Maximum="127"
                                                  Value="{Binding ExpressionBMax, Mode=TwoWay}" FormatString="000"
                                                  IsEnabled="{Binding ExpressionBEnabled}"/>
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Classes="stageEyebrow" Text="CONTACT" HorizontalAlignment="Center" LetterSpacing="2"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ctrl:RelayLatchControl Width="80" Height="84" Label="SW1" SubLabel="SW"
                                              IsClosed="{Binding Switch1Closed, Mode=TwoWay}"
                                              ToolTip.Tip="Relay SWITCH 1"/>
                      <ctrl:RelayLatchControl Width="80" Height="84" Label="SW2" SubLabel="SW"
                                              IsClosed="{Binding Switch2Closed, Mode=TwoWay}"
                                              ToolTip.Tip="Relay SWITCH 2"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>

            <!-- Status rail — single line, no scroll -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#454C52"
                         Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding PendingChanges}" IsVisible="{Binding HasChanges}"
                            Margin="12,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:ConfigChange">
                    <Border Background="#12161B" BorderBrush="#2A1810" BorderThickness="1" CornerRadius="10"
                            Padding="8,3">
                      <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="9">
                        <Run Text="{Binding Field}" Foreground="#8B949C"/><Run Text=" → " Foreground="#454C52"/><Run Text="{Binding To}" Foreground="{DynamicResource StageAmber}"/>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Grid>
        </Border>
      </DockPanel>

      <!-- ═══ MAP — bank rails mirroring the real pedalboard (1–5 | 6–10) ═══ -->
      <Border IsVisible="{Binding IsMapWorkspace}" Classes="workspaceFace" ClipToBounds="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#050607" Offset="0"/>
            <GradientStop Color="#090B0E" Offset="0.5"/>
            <GradientStop Color="#06080A" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <DockPanel>
          <!-- Focus bar: selection + legend inline — no wasted sidebar -->
          <Border DockPanel.Dock="Top" Background="#080A0C" BorderBrush="#161B21" BorderThickness="1"
                  CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="stageEyebrow" Text="MAP" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource StageSignal}"
                           Text="{Binding Bank, StringFormat={}{0:00}}" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="16" Foreground="#2A3038"
                           Text="·" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource StageAmber}"
                           Text="{Binding Footswitch, StringFormat={}{0:00}}" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontDisplay}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E8EEF2" Text="{Binding PresetName}" VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Background="#12161B" CornerRadius="4" Padding="8,3">
                  <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource StageTeal}" Text="{Binding RoleLabel}"/>
                </Border>
                <Border Background="#12161B" CornerRadius="4" Padding="8,3" IsVisible="{Binding ActionSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#8B949C"
                             Text="{Binding ActionSummary}"/>
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource StageSignal}"/><TextBlock Classes="stageEyebrow" Text="SEL"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource StageTeal}"/><TextBlock Classes="stageEyebrow" Text="MIDI"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="6" Height="6" Fill="{DynamicResource StageAmber}"/><TextBlock Classes="stageEyebrow" Text="STOMP"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Ellipse Width="6" Height="6" Fill="#55606A"/><TextBlock Classes="stageEyebrow" Text="EXP"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Column legend: lower pedals | upper pedals -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="44,*,12,*" Margin="0,0,0,4">
            <TextBlock Classes="stageEyebrow" Text="BANK" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*,*">
              <TextBlock Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="1" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="2" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="3" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="3" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="4" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="4" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="5" HorizontalAlignment="Center"/>
            </Grid>
            <Border Grid.Column="2" Width="1" Background="#1A2028" HorizontalAlignment="Center" Margin="0,2"/>
            <Grid Grid.Column="3" ColumnDefinitions="*,*,*,*,*">
              <TextBlock Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="6" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="7" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="2" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="8" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="3" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="9" HorizontalAlignment="Center"/>
              <TextBlock Grid.Column="4" Classes="stageEyebrow" FontSize="12" FontWeight="Bold" Text="10" HorizontalAlignment="Center"/>
            </Grid>
          </Grid>

          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding MapBanks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="0"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MapBankRowViewModel">
                  <Border Classes="bankRail" Classes.activeBank="{Binding IsActiveBank}">
                    <Grid ColumnDefinitions="118,*,10,*" ColumnSpacing="0" Height="62">
                      <Border Background="#0C0F13" CornerRadius="6" Margin="0,0,8,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="104">
                          <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="20" FontWeight="Bold"
                                     Foreground="{DynamicResource StageAmber}" Text="{Binding BankLabel}"
                                     HorizontalAlignment="Center"/>
                          <TextBlock Classes="stageEyebrow" Text="{Binding BankName}" FontSize="9"
                                     TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                     ToolTip.Tip="{Binding BankName}"/>
                        </StackPanel>
                      </Border>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Lower}"
                                    ItemTemplate="{StaticResource MapPedalPad}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <Border Grid.Column="2" Width="2" Background="#151A20" CornerRadius="1"
                              HorizontalAlignment="Center" Margin="3,8"/>
                      <ItemsControl Grid.Column="3" ItemsSource="{Binding Upper}"
                                    ItemTemplate="{StaticResource MapPedalPad}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ═══ ROUTING — grouped mixer lanes that fill the bay ═══ -->
      <Border IsVisible="{Binding IsRoutingWorkspace}" Classes="workspaceFace" ClipToBounds="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#050607" Offset="0"/>
            <GradientStop Color="#090B0E" Offset="0.5"/>
            <GradientStop Color="#06080A" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#080A0C" BorderBrush="#161B21" BorderThickness="1"
                  CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Bold"
                           Foreground="#8B949C" Text="MIDI ROUTING" LetterSpacing="1.5" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource StageTeal}" Text="GLOBAL CHANNEL MATRIX" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton Classes="flagKey" IsChecked="{Binding DirectSelect}"
                              ToolTip.Tip="Direct Select — jump to presets without bank confirmation">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse Classes="jewel" Width="9" Height="9" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="code" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                 FontWeight="Bold" Text="DIR" LetterSpacing="1.6"/>
                      <TextBlock Classes="caption" FontFamily="{DynamicResource FontDisplay}" FontSize="12"
                                 Text="Direct select"/>
                    </StackPanel>
                  </Grid>
                </ToggleButton>
                <ToggleButton Classes="flagKey" IsChecked="{Binding RunningStatus}"
                              ToolTip.Tip="Running Status — omit redundant MIDI status bytes">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse Classes="jewel" Width="9" Height="9" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="code" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                 FontWeight="Bold" Text="RUN" LetterSpacing="1.6"/>
                      <TextBlock Classes="caption" FontFamily="{DynamicResource FontDisplay}" FontSize="12"
                                 Text="Running status"/>
                    </StackPanel>
                  </Grid>
                </ToggleButton>
                <ToggleButton Classes="flagKey" IsChecked="{Binding MidiMerge}"
                              ToolTip.Tip="MIDI Merge — pass through MIDI from the input port">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse Classes="jewel" Width="9" Height="9" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock Classes="code" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                 FontWeight="Bold" Text="MRG" LetterSpacing="1.6"/>
                      <TextBlock Classes="caption" FontFamily="{DynamicResource FontDisplay}" FontSize="12"
                                 Text="MIDI merge"/>
                    </StackPanel>
                  </Grid>
                </ToggleButton>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Spacing="16">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource StageTeal}" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontDisplay}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource StageTeal}" Text="PROGRAM CHANGES" LetterSpacing="1.2"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ProgramRoutes}" ItemTemplate="{StaticResource MixStripTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="0"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource StageAmber}" VerticalAlignment="Center"/>
                <TextBlock FontFamily="{DynamicResource FontDisplay}" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource StageAmber}" Text="CONTROL · EXPRESSION · NOTE" LetterSpacing="1.2"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding AuxRoutes}" ItemTemplate="{StaticResource MixStripTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="0"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ═══ DIAGNOSTICS — traffic console + hex bay ═══ -->
      <Border IsVisible="{Binding IsDiagnosticsWorkspace}" Classes="workspaceFace" ClipToBounds="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#050607" Offset="0"/>
            <GradientStop Color="#0A0C0F" Offset="0.55"/>
            <GradientStop Color="#07090B" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Classes="stageEyebrow" Text="DIAGNOSTICS BAY" VerticalAlignment="Center"/>
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="#5C656E"
                         Text="{Binding RawHex}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         MaxWidth="720"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#101418" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource StageAmber}" Text="{Binding DeviceSync}"/>
            </Border>
            <Border Grid.Column="2" Background="#101418" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource StageTeal}" Text="{Binding EditorSync}"/>
            </Border>
            <Border Grid.Column="3" Background="#101418" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
              <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                         Foreground="#8B949C" Text="{Binding ProjectSync}"/>
            </Border>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,1.05*" ColumnSpacing="12">
            <!-- MIDI traffic -->
            <Border Classes="stagePlate" Padding="0" ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#1A1F26" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="stageEyebrow" Text="MIDI TRAFFIC" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" FontFamily="{DynamicResource FontMono}" FontSize="9"
                               Foreground="#5C656E" Text="LIVE · NEWEST FIRST"/>
                  </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="midi:MidiDiagnostic">
                        <Border Classes="consoleRow">
                          <Grid ColumnDefinitions="64,36,88,48,*" ColumnSpacing="8">
                            <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#5C656E"
                                       Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"/>
                            <TextBlock Grid.Column="1" FontFamily="{DynamicResource FontMono}" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource StageTeal}" Text="{Binding Direction}"/>
                            <TextBlock Grid.Column="2" FontFamily="{DynamicResource FontMono}" FontSize="10"
                                       Foreground="#C8D0D6" Text="{Binding MessageType}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" FontFamily="{DynamicResource FontMono}" FontSize="10"
                                       Foreground="#6A737C" Text="{Binding Size, StringFormat={}{0} B}"/>
                            <TextBlock Grid.Column="4" FontFamily="{DynamicResource FontMono}" FontSize="10"
                                       Foreground="#8B949C" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <!-- Hex inspector -->
            <Border Grid.Column="1" Classes="stagePlate" Padding="0" ClipToBounds="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#1A1F26" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="stageEyebrow" Text="DECODED MEMORY" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" FontFamily="{DynamicResource FontMono}" FontSize="9"
                               Foreground="#5C656E" Text="PRESET · GLOBALS · DIFF"/>
                  </Grid>
                </Border>
                <Border DockPanel.Dock="Top" Padding="12,6" Background="#0A0D10">
                  <Grid ColumnDefinitions="52,36,*,120" ColumnSpacing="8">
                    <TextBlock Classes="stageEyebrow" Text="OFF"/>
                    <TextBlock Grid.Column="1" Classes="stageEyebrow" Text="HEX"/>
                    <TextBlock Grid.Column="2" Classes="stageEyebrow" Text="MEANING"/>
                    <TextBlock Grid.Column="3" Classes="stageEyebrow" Text="Δ"/>
                  </Grid>
                </Border>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding HexRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:HexRowViewModel">
                        <Border Classes="consoleRow" Classes.changed="{Binding IsChanged}">
                          <Grid ColumnDefinitions="52,36,*,120" ColumnSpacing="8">
                            <TextBlock FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource StageAmber}" Text="{Binding Offset}"/>
                            <TextBlock Grid.Column="1" FontFamily="{DynamicResource FontMono}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource StageTeal}" Text="{Binding Hex}"/>
                            <TextBlock Grid.Column="2" FontFamily="{DynamicResource FontMono}" FontSize="10"
                                       Foreground="#C8D0D6" Text="{Binding Meaning}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" FontFamily="{DynamicResource FontMono}" FontSize="10"
                                       Foreground="#8B949C" Text="{Binding Changed}" TextTrimming="CharacterEllipsis"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="2" FontFamily="{DynamicResource FontMono}" FontSize="10" Foreground="#454C52"
                     Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </Panel>
  </DockPanel>
</Window>
